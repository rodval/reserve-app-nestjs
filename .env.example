# Base de desarrollo (servicio dev-db de docker-compose)
DATABASE_URL="postgresql://postgres:123@localhost:5434/nest?schema=public"
PORT=3000

# Firma de los tokens JWT (en producción usar un valor largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# Duración del token: 15m, 1h, 7d...
JWT_EXPIRES_IN=1h

# Usuario admin inicial (npm run db:seed)
SEED_ADMIN_EMAIL=admin@reserve.app
SEED_ADMIN_PASSWORD=cambia-esta-clave
